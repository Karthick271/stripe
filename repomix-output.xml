# ------------------------------------------------------------------------------
@app.route("/zoho", methods=["GET"])
def zoho_page():
    row = get_latest_row_for_user(ZOHO_USER_ID)
    connected = row is not None
    return render_template(
        "zoho.html",
        connected=connected,
        accounts_url=ZOHO_ACCOUNTS_URL,
        scope=ZOHO_OAUTH_SCOPE,
        redirect_uri=ZOHO_REDIRECT_URI
    )

@app.route("/auth", methods=["GET"])
def auth():
    state = __import__("secrets").token_urlsafe(24)
    session["zoho_state"] = state
    return redirect(zoho_authorize_url(state))

@app.route("/callback", methods=["GET"])
def callback():
    error = request.args.get("error")
    if error:
        logging.error("Zoho callback error: %s", error)
        return abort(400, description=error)

    state = request.args.get("state")
    code = request.args.get("code")
    if not code or not state or state != session.get("zoho_state"):
        return abort(400, description="Invalid state or missing code")

    try:
        token_res = zoho_exchange_code_for_tokens(code)
        if not token_res.get("access_token") or not token_res.get("refresh_token"):
            logging.error("Unexpected token payload: %s", token_res)
            return abort(500, description="Token exchange failed")
        save_tokens_for_user(ZOHO_USER_ID, token_res)
        logging.info("Zoho connected. Tokens saved for user_id=%s", ZOHO_USER_ID)
        return redirect("/zoho")
    except requests.HTTPError as e:
        logging.exception("Zoho token exchange HTTP error")
        return abort(502, description=f"Zoho token exchange failed: {e.response.text}")
    except Exception:
        logging.exception("Zoho token exchange error")
        return abort(500, description="Zoho token exchange failed")

@app.route("/disconnect", methods=["POST"])
def disconnect():
    row = get_latest_row_for_user(ZOHO_USER_ID)
    if row and row.get("Refresh_Token"):
        try:
            status, body = zoho_revoke_token(row["Refresh_Token"])
            logging.info("Zoho revoke status=%s body=%s", status, body)
        except Exception:
            logging.exception("Zoho revoke failed (continuing to clear local tokens)")
    clear_tokens_for_user(ZOHO_USER_ID)
    return redirect("/zoho")

# Example protected Zoho call using always-fresh token
@app.route("/zoho/me", methods=["GET"])
def zoho_me():
    token = get_access_token_by_user(ZOHO_USER_ID)
    if not token:
        return abort(401, description="Zoho not connected")

    # Hit a simple endpoint (orgs) as a sanity check
    resp = requests.get(
        f"https://{ZOHO_API_DOMAIN}/crm/v2/org",
        headers={"Authorization": f"Zoho-oauthtoken {token}"},
        timeout=20
    )
    if resp.status_code >= 400:
        return abort(resp.status_code, resp.text)
    return jsonify(resp.json())
    

    
if __name__ == '__main__':
    app.run(debug=True, host="0.0.0.0", port=8000)
